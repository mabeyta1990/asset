# ASSET Pipeline — Required Environment Variables
# ------------------------------------------------
# Recommended: inject secrets via Doppler CLI (never commit real values).
#
# Local development with Doppler:
#   1. brew install dopplerhq/cli/doppler
#   2. doppler login
#   3. doppler setup          # link to the "asset" project
#   4. doppler run -- npm run asset "your task"
#
# Local development without Doppler:
#   cp .env.example .env
#   # Fill in real values in .env (never commit .env)
#
# CI/CD:
#   Export secrets via your CI provider's secret manager and pass them as
#   environment variables at runtime. The app reads them from the process
#   environment — no Doppler CLI daemon required in CI.

ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
TAVILY_API_KEY=
ZAI_API_KEY=
DEEPINFRA_API_KEY=
